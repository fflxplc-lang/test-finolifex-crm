# /etc/systemd/system/finowise-test.service  (test copy; prod is finowise.service)
[Unit]
Description=Finowise CRM (test copy)
After=network.target

[Service]
User=finowise-test
WorkingDirectory=/home/finowise-test/app
EnvironmentFile=/home/finowise-test/app.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
